generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  merchant
  admin
}

enum SubscriptionStatus {
  trialing
  active
  cancelled
  expired
}

enum ShopStatus {
  active
  inactive
  suspended
  closed
}

enum SyncStatus {
  ok
  pending
  error
}

enum OrderStatus {
  pending
  new
  confirmed
  in_progress
  ready
  delivered
  cancelled
}

enum OrderChannel {
  whatsapp
  online
  manual
}

enum PaymentStatus {
  unpaid
  partial
  paid
  refunded
}

enum PaymentMethod {
  cash
  mobile_money
  bank_transfer
  cod
}

enum WhatsappLogType {
  relance
  confirmation
  custom
  template
}

enum PaymentTransactionStatus {
  pending
  paid
  failed
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

// ─── Auth & Identity ──────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole      @default(merchant)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  shops        Shop[]
  subscription Subscription?
  transactions PaymentTransaction[]

  @@index([createdAt])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String
  code         String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model PendingPasswordReset {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// ─── Plans & Subscriptions ────────────────────────────────────────────────────

model Plan {
  id           String         @id @default(cuid())
  name         String         @unique   // "starter" | "business" | "premium"
  displayName  String                   // "Starter" | "Business" | "Premium"
  maxShops     Int                      // 1 / 3 / 10
  maxProducts  Int                      // 20 / 500 / -1 (unlimited)
  priceMonthly Decimal        @db.Decimal(10, 2)
  features     String[]       @default([])
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  subscriptions Subscription[]
  transactions  PaymentTransaction[]
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  planId            String
  status            SubscriptionStatus @default(active)
  billingCycle      BillingCycle       @default(monthly)
  startedAt         DateTime           @default(now())
  expiresAt         DateTime?
  provider          String?
  providerReference String?
  providerPaymentId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@index([planId])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  userId            String
  subscriptionId    String?
  planId            String
  billingCycle      BillingCycle             @default(monthly)
  amount            Decimal                  @db.Decimal(12, 2)
  currency          String                   @default("XOF")
  status            PaymentTransactionStatus @default(pending)
  provider          String                   @default("geniuspay")
  providerReference String?                  @unique
  providerPaymentId String?
  checkoutUrl       String?
  webhookPayload    Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([providerReference])
}

model WebhookEvent {
  id                String    @id @default(cuid())
  provider          String
  eventType         String
  providerReference String?
  payload           Json
  processed         Boolean   @default(false)
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([provider, eventType])
  @@index([providerReference])
}

// ─── Shops ────────────────────────────────────────────────────────────────────

model Shop {
  id                String     @id @default(cuid())
  userId            String                       // NOT @unique — 1 user → N shops
  slug              String     @unique
  name              String
  status            ShopStatus @default(active)
  notificationEmail String?
  logoUrl           String?
  coverUrl          String?
  description       String?
  city              String?
  postalCode        String?
  regionCountry     String?
  whatsappNumber    String
  category          String?
  address           String?
  openingHours      String?
  paymentMethods    String[]   @default([])
  isPublished       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  customers     Customer[]
  orders        Order[]
  whatsappLogs  WhatsappLog[]

  @@index([userId])
  @@index([name])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id            String     @id @default(cuid())
  shopId        String
  name          String
  category      String?
  categories    String[]   @default([])
  description   String?
  sku           String?
  unitPrice     Decimal    @db.Decimal(12, 2)
  stock         Int        @default(0)
  syncStatus        SyncStatus @default(ok)
  imageUrl          String?
  imageVariants     String[]   @default([])
  isActive          Boolean    @default(true)
  hasVariants       Boolean    @default(false)
  lowStockThreshold Int        @default(5)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  variants   ProductVariant[]

  @@index([shopId, createdAt])
  @@index([shopId, name])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  label         String
  sku           String?
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

// ─── Customers ────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  fullName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([shopId, createdAt])
  @@index([shopId, phone])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  shopId        String
  customerId    String
  channel       OrderChannel  @default(manual)
  status        OrderStatus   @default(new)
  paymentStatus PaymentStatus @default(unpaid)
  paymentMethod PaymentMethod?
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  whatsappLogs  WhatsappLog[]
  statusHistory OrderStatusHistory[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([shopId, channel])
  @@index([customerId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  variantLabel String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ─── Order Status History ─────────────────────────────────────────────────────

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedAt DateTime    @default(now())
  note      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── WhatsApp ─────────────────────────────────────────────────────────────────

model WhatsappLog {
  id      String          @id @default(cuid())
  shopId  String
  orderId String?
  type    WhatsappLogType
  message String
  sentAt  DateTime        @default(now())

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([orderId])
}
