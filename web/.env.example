# Modèle d'environnement BizManager.
#
# Copiez ce fichier en `.env.local` puis remplacez chaque valeur.
# `.env.local` est ignoré par git : il ne doit JAMAIS être committé.
#
#   cp .env.example .env.local
#
# Prisma en ligne de commande (`npx prisma migrate`, `npx prisma db seed`) lit
# `.env` et non `.env.local`. Un `.env` contenant au minimum DATABASE_URL et
# JWT_SECRET est donc nécessaire en plus.

# ── Base de données ──────────────────────────────────────────────────────────
# Le docker-compose.yml à la racine du dépôt expose PostgreSQL sur le port 5434.
# Démarrage : docker compose up -d postgres
DATABASE_URL="postgresql://commerce:VOTRE_MOT_DE_PASSE@localhost:5434/commerce?schema=public"

# ── Authentification ─────────────────────────────────────────────────────────
# Signature des sessions JWT. 32 caractères minimum.
# Générer : openssl rand -base64 32
JWT_SECRET="remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Clé HMAC des codes OTP de confirmation de livraison (src/lib/otp.ts).
# Non définie, le code retombe sur une valeur par défaut en dur : acceptable en
# développement, à proscrire en production.
OTP_SECRET="remplacer-par-une-chaine-aleatoire"

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Emails autorisés à accéder à /admin, séparés par des virgules.
PLATFORM_ADMIN_EMAILS="votre.adresse@exemple.com"

# ── SMTP : vérification d'email et réinitialisation de mot de passe ──────────
# Avec Gmail, SMTP_PASS doit être un mot de passe d'application, pas le mot de
# passe du compte.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre.adresse@gmail.com"
SMTP_PASS="mot-de-passe-application"
SMTP_FROM="BizManager <votre.adresse@gmail.com>"

# ── Cloudinary : stockage des images et vidéos produits ──────────────────────
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── GeniusPay : paiements abonnements et commandes ───────────────────────────
GENIUSPAY_API_KEY="pk_sandbox_xxxxxxxxxxxxxxxx"
GENIUSPAY_API_SECRET="sk_sandbox_xxxxxxxxxxxxxxxx"
GENIUSPAY_BASE_URL="https://pay.genius.ci/api/v1/merchant"
GENIUSPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# ── Connexion Google (optionnel) ─────────────────────────────────────────────
# Laisser vide pour désactiver le bouton « Continuer avec Google ».
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# ── WhatsApp Cloud API (optionnel) ───────────────────────────────────────────
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
